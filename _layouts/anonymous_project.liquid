---
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <meta name="description" content="{{ page.description | escape }}">
    <meta name="author" content="Anonymous">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ page.title | escape }}">
    <meta property="og:description" content="{{ page.description | escape }}">
    {% if page.og_image %}
      <meta property="og:image" content="{{ page.og_image | absolute_url }}">
    {% endif %}
    <title>
      {{ page.title | escape }}
      — Research project
    </title>
    <link rel="icon" href="{{ '/assets/img/projects/offsite/favicon.svg' | relative_url }}" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    >
    <link rel="stylesheet" href="{{ '/assets/css/project-page.css' | relative_url }}">
    <link rel="stylesheet" href="{{ '/assets/css/offsite.css' | relative_url }}">
  </head>
  <body>
    <a class="os-skip-link" href="#main">Skip to content</a>
    {{ content }}
    <script defer src="{{ '/assets/js/project-page.js' | relative_url }}"></script>
  </body>
</html>
